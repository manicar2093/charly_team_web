---
import type {SliceItem} from "../data/celebritySliderImages";

interface Props {
    gridName: string;
    items: Array<SliceItem>;
}

const { items, gridName } = Astro.props;
---

<div class:list={["grid-gallery", `${gridName}-gallery`]} >
    {
        items.map((item, index) => (
            <div class="gallery-image" data-image-gallery-dialog-id=`${index}`>
                <img src={item.imgSrc} class="img-fluid" alt={item.imgAlt} />
            </div>
            <dialog id=`grid-${index}-dialog`>
                <form method="dialog">
                    <button class="close-dialog" autofocus>x</button>
                </form>
                <img src={item.imgSrc} class="img-fluid" alt={item.imgAlt}/>
            </dialog>
        ))
    }
</div>

<style>
    .grid-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        column-gap: .5rem;
        row-gap: .5rem;
    }
    .gallery-image {
        display: flex;
        justify-content: center;
    }
    .gallery-image img {
        object-fit: cover;;
    }
    dialog {
        opacity: 0;
        transform: scale(0);
        transition: all 0.5s allow-discrete;
    }
    dialog[open] {
        opacity: 1;
        transform: scale(1);
    }
    @starting-style {
        dialog[open] {
            opacity: 0;
            transform: scale(0);
        }
    }

    dialog::backdrop {
        background-color: rgb(0 0 0 / 0%);
        transition: all 0.5s allow-discrete;
    }
    dialog[open]::backdrop {
        background-color: rgb(0 0 0 / 25%);
    }
    @starting-style {
        dialog[open]::backdrop {
            background-color: rgb(0 0 0 / 0%);
        }
    }
</style>

<script>
    const galleryImages = document.querySelectorAll('.gallery-image');
    galleryImages.forEach(item => {
        const index = item.dataset.imageGalleryDialogId;
        const key = `#grid-${index}-dialog`
        const dialog = document.querySelector(key)
        if(!dialog) console.error('No dialog found for index ', index,)
        item.addEventListener('click', () => {
            dialog.showModal()
        })
    })
</script>